# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration (Standardized)
# Note: For local development, configure credentials for your local MySQL instance.
# In production, use high-entropy credentials via secret managers.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eoms
DB_USER=root
DB_PASSWORD=

# Authentication (JWT)
